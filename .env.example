# ==========================================================
# MOOVMA WEBSITE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# Add the same variables in Vercel: Project > Settings > Environment Variables.
# ==========================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only (API routes). NEVER expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Public address used for link previews, sitemap.xml and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://moovma-git-main-moovma.vercel.app
# Address the contact forms send to.
NEXT_PUBLIC_CONTACT_EMAIL=moovmabh@gmail.com

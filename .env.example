# ==========================================================
# MOOVMA WEBSITE - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# Add the same variables in Vercel: Project > Settings > Environment Variables.
# ==========================================================

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-side only (API routes). NEVER expose it in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ---
# Public address used for link previews, sitemap.xml and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.moovma.tn
# Address the contact forms send to.
NEXT_PUBLIC_CONTACT_EMAIL=moovmabh@gmail.com

# --- Emails: pre-order alerts + daily report (see supabase_email_settings.sql) ---
# Create a free account at resend.com WITH moovmabh@gmail.com, then API Keys > Create.
RESEND_API_KEY=re_your_key_here
# Any long random string. Vercel sends it to /api/cron/daily-report automatically.
CRON_SECRET=a-long-random-string
# Optional. Fallback address if the email_settings table is missing (default moovmabh@gmail.com).
NOTIFY_EMAIL=moovmabh@gmail.com
# Optional. Only after verifying your own domain in Resend, e.g. Moovma <orders@moovma.tn>
# EMAIL_FROM=Moovma <onboarding@resend.dev>
